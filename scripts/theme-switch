#!/usr/bin/env python3
"""theme-switch - central color theming for sway, waybar, alacritty, swaylock, dunst.

Usage:
    theme-switch [theme_name]      Apply colors.toml (or a preset in themes/) everywhere
    theme-switch --list            List available theme presets
    theme-switch --restore         Restore configs from .theme.bak snapshots
    theme-switch --dry-run         Show what would change without writing

A backup of each config is stored alongside it as <file>.theme.bak on the
first apply, so --restore can always revert to the pre-script state.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

HOME = Path.home()
THEME_DIR = HOME / ".config" / "theme"
COLORS_FILE = THEME_DIR / "colors.toml"
THEMES_DIR = THEME_DIR / "themes"
BACKUP_SUFFIX = ".theme.bak"

SWAY_CFG = HOME / ".config" / "sway" / "config"
SWAY_COLORS = HOME / ".config" / "sway" / "colors.conf"
WAYBAR_CSS = HOME / ".config" / "waybar" / "style.css"
ALACRITTY = HOME / ".config" / "alacritty" / "lasthorizon.toml"
SWAYLOCK = HOME / ".config" / "swaylock" / "config"
DUNST = HOME / ".config" / "dunst" / "dunstrc"


def load_colors(theme_name):
    """Load a color dict, merging an optional preset over the base colors.toml."""
    with open(COLORS_FILE, "rb") as f:
        base = tomllib.load(f)["colors"]

    if theme_name:
        preset_file = THEMES_DIR / f"{theme_name}.toml"
        if not preset_file.exists():
            print(f"error: unknown theme '{theme_name}'", file=sys.stderr)
            list_themes()
            sys.exit(1)
        with open(preset_file, "rb") as f:
            preset = tomllib.load(f)["colors"]
        base.update(preset)
    return base


def list_themes():
    print("Available themes:")
    print("  (default)   colors.toml")
    if THEMES_DIR.exists():
        for p in sorted(THEMES_DIR.glob("*.toml")):
            print(f"  {p.stem}")


def maybe_backup(path):
    """Snapshot the original file the first time we touch it."""
    if path.exists() and not Path(str(path) + BACKUP_SUFFIX).exists():
        shutil.copy2(path, str(path) + BACKUP_SUFFIX)


def write(path, content, dry_run):
    if dry_run:
        print(f"[dry-run] write {path}")
        return
    maybe_backup(path)
    path.write_text(content)
    print(f"wrote {path}")


# ---------------------------------------------------------------- Sway
# Stock sway default colors (sway(5)) for the "vanilla" theme.
VANILLA_CLIENT = {
    "client.focused":          "#4c7899 #285577 #ffffff #2e9ef4 #285577",
    "client.focused_inactive": "#333333 #5f676a #ffffff #484e50 #5f676a",
    "client.unfocused":        "#333333 #222222 #888888 #292d2e #222222",
    "client.urgent":           "#2f343a #900000 #ffffff #900000 #900000",
}


def gen_sway(c, dry_run, theme_name=None):
    maybe_backup(SWAY_CFG)
    colors_conf = "\n".join(
        [
            "# GENERATED by theme-switch - edits will be overwritten",
            f"set $col_bg       {c['bg']}",
            f"set $col_bg_alt   {c['bg_alt']}",
            f"set $col_bg_high  {c['bg_high']}",
            f"set $col_fg       {c['fg']}",
            f"set $col_fg_dark  {c['fg_dark']}",
            f"set $col_blue     {c['blue']}",
            f"set $col_cyan     {c['cyan']}",
            f"set $col_green    {c['green']}",
            f"set $col_yellow   {c['yellow']}",
            f"set $col_orange   {c['orange']}",
            f"set $col_red      {c['orange']}",
            f"set $col_magenta  {c['magenta']}",
            "",
        ]
    )
    write(SWAY_COLORS, colors_conf, dry_run)

    text = SWAY_CFG.read_text()
    # Replace the old inline palette block (from the palette comment to the magenta set line).
    block_re = re.compile(
        r"# Last Horizon Color Palette.*?set \$tn_magenta\s+#[0-9a-fA-F]{6}\n*",
        re.DOTALL,
    )
    new_block = '# theme generated colors (see colors.conf)\ninclude ~/.config/sway/colors.conf\n\n'
    if block_re.search(text):
        text = block_re.sub(new_block, text, count=1)
    else:
        # Fallback: append include at end if the block wasn't found.
        if "include ~/.config/sway/colors.conf" not in text:
            text += "\ninclude ~/.config/sway/colors.conf\n"

    # Rewrite client.* color rules.
    # Order: border bg text indicator child_border.
    if theme_name == "vanilla":
        for cls, colors in VANILLA_CLIENT.items():
            pattern = rf"^{re.escape(cls)}\s+.*$"
            replacement = f"{cls} {colors}"
            if re.search(pattern, text, flags=re.MULTILINE):
                text = re.sub(pattern, replacement, text, flags=re.MULTILINE)
    else:
        text = re.sub(
            r"client\.focused\s+.*",
            f"client.focused                  $col_blue    $col_blue    $col_bg      $col_cyan    $col_blue",
            text,
        )
        text = re.sub(
            r"client\.focused_inactive\s+.*",
            f"client.focused_inactive         $col_bg_high $col_bg_high $col_fg_dark $col_bg_high $col_bg_high",
            text,
        )
        text = re.sub(
            r"client\.unfocused\s+.*",
            f"client.unfocused                $col_bg      $col_bg      $col_fg_dark $col_bg      $col_bg",
            text,
        )
        text = re.sub(
            r"client\.urgent\s+.*",
            f"client.urgent                   $col_red     $col_red     $col_bg      $col_red     $col_red",
            text,
        )
    write(SWAY_CFG, text, dry_run)


# ---------------------------------------------------------------- Waybar
def gen_waybar(c, dry_run):
    maybe_backup(WAYBAR_CSS)
    text = WAYBAR_CSS.read_text()
    var_block = "\n".join(
        [
            f"@define-color bg {c['bg']};",
            f"@define-color fg {c['fg']};",
            f"@define-color red {c['blue']};",
            f"@define-color grey {c['bg_high']};",
            f"@define-color accent {c['blue']};",
            f"@define-color warning {c['cyan']};",
            f"@define-color ok {c['green']};",
            "",
        ]
    )
    # Split off the existing var block so the hex->var replacement below
    # never touches the freshly written @define-color lines (avoids
    # self-referencing vars like "@define-color grey @grey;").
    var_re = re.compile(
        r"@define-color bg .*?;\n@define-color fg .*?;\n@define-color red .*?;\n@define-color grey .*?;\n*",
        re.DOTALL,
    )
    rest = var_re.sub("", text, count=1)
    # Replace hard-coded hex in the body only.
    rest = rest.replace("#c38b7b", "@red")
    rest = rest.replace("#a5a0b6", "@warning")
    rest = rest.replace("#584e51", "@grey")
    text = var_block + rest
    write(WAYBAR_CSS, text, dry_run)


# ---------------------------------------------------------------- Alacritty
def gen_alacritty(c, dry_run):
    content = "\n".join(
        [
            "# GENERATED by theme-switch - edits will be overwritten",
            "[colors.primary]",
            f'background = "{c["bg"]}"',
            f'foreground = "{c["fg"]}"',
            "",
            "[colors.cursor]",
            f'text = "{c["bg"]}"',
            f'cursor = "{c["bright"]}"',
            "",
            "[colors.vi_mode_cursor]",
            f'text = "{c["bg"]}"',
            f'cursor = "{c["bright"]}"',
            "",
            "[colors.search.matches]",
            f'foreground = "{c["bg"]}"',
            f'background = "{c["orange"]}"',
            "",
            "[colors.search.focused_match]",
            f'foreground = "{c["bg"]}"',
            f'background = "{c["cyan"]}"',
            "",
            "[colors.footer_bar]",
            f'foreground = "{c["bg"]}"',
            f'background = "{c["fg"]}"',
            "",
            "[colors.selection]",
            f'text = "{c["bg"]}"',
            f'background = "{c["blue"]}"',
            "",
            "[colors.normal]",
            f'black = "{c["bg"]}"',
            f'red = "{c["orange"]}"',
            f'green = "{c["green"]}"',
            f'yellow = "{c["yellow"]}"',
            f'blue = "{c["blue"]}"',
            f'magenta = "{c["magenta"]}"',
            f'cyan = "{c["cyan"]}"',
            f'white = "{c["fg_dark"]}"',
            "",
            "[colors.bright]",
            f'black = "{c["bg_high"]}"',
            f'red = "{c["orange"]}"',
            f'green = "{c["green"]}"',
            f'yellow = "{c["yellow"]}"',
            f'blue = "{c["blue"]}"',
            f'magenta = "{c["magenta"]}"',
            f'cyan = "{c["cyan"]}"',
            f'white = "{c["bright"]}"',
            "",
        ]
    )
    write(ALACRITTY, content, dry_run)


# ---------------------------------------------------------------- Swaylock
def gen_swaylock(c, dry_run):
    maybe_backup(SWAYLOCK)
    text = SWAYLOCK.read_text()
    replacements = {
        "color=": f"color={c['bg'].lstrip('#')}",
        "line-color=": f"line-color={c['bg_high']}",
        "text-color=": f"text-color={c['bright']}",
        "inside-color=": f"inside-color={c['bg']}aa",
        "inside-ver-color=": f"inside-ver-color={c['blue']}",
        "line-ver-color=": f"line-ver-color={c['blue']}",
        "ring-ver-color=": f"ring-ver-color={c['blue']}aa",
        "ring-color=": f"ring-color={c['bg_high']}",
        "key-hl-color=": f"key-hl-color={c['cyan']}",
        "separator-color=": f"separator-color={c['bg_alt']}",
        "layout-text-color=": f"layout-text-color={c['fg_dark']}",
        "line-wrong-color=": f"line-wrong-color={c['orange']}",
    }
    for key, value in replacements.items():
        # Matches "key<existing hex>" at line start (allow optional # on values).
        text = re.sub(rf"^{re.escape(key)}.*$", value, text, flags=re.MULTILINE)
    write(SWAYLOCK, text, dry_run)


# ---------------------------------------------------------------- Dunst
def _set_line(text, key, value):
    """Replace the value on a line of the form '<key> = "<old hex>"' (quotes optional)."""
    return re.sub(rf'^(\s*{re.escape(key)}\s*=\s*)"?#[0-9a-fA-F]{{6}}"?$',
                  rf'\g<1>"{value}"', text, flags=re.MULTILINE)


_sec_colors = {
    "urgency_low": ("bg", "fg_dark"),
    "urgency_normal": ("bg", "fg"),
    "urgency_critical": ("orange", "bg"),
    "irc": ("blue", "bg"),
    "weechat hl": ("orange", "bg"),
    "weechat pn": ("cyan", "bg"),
}


def gen_dunst(c, dry_run):
    maybe_backup(DUNST)
    text = DUNST.read_text()

    # global frame/separator accents -> blue
    text = _set_line(text, "frame_color", c["blue"])
    text = _set_line(text, "separator_color", c["blue"])

    # Rewrite each section's background/foreground to their semantic colors.
    # Hex-match-free so switching between any two themes is always correct.
    for section, (bg_key, fg_key) in _sec_colors.items():
        m = re.search(rf"^\[{re.escape(section)}\]$", text, re.MULTILINE)
        if not m:
            continue
        start = m.end()
        nxt = re.search(r"^\[[^\]]+\]$", text[start:], re.MULTILINE)
        end = len(text) if nxt is None else start + nxt.start()
        body = text[start:end]
        body = _set_line(body, "background", c[bg_key])
        body = _set_line(body, "foreground", c[fg_key])
        text = text[:start] + body + text[end:]

    write(DUNST, text, dry_run)


# ---------------------------------------------------------------- Reload
def reload_all():
    def run(cmd):
        try:
            subprocess.run(cmd, check=False)
        except FileNotFoundError:
            pass

    print("reloading sway...")
    run(["swaymsg", "reload"])
    print("reloading dunst...")
    run(["dunstctl", "reload"])


# ---------------------------------------------------------------- Restore
def restore():
    files = [SWAY_COLORS, SWAY_CFG, WAYBAR_CSS, ALACRITTY, SWAYLOCK, DUNST]
    for path in files:
        bak = Path(str(path) + BACKUP_SUFFIX)
        if bak.exists():
            shutil.copy2(bak, path)
            print(f"restored {path}")
        else:
            print(f"no backup for {path} (skipped)")


def main():
    parser = argparse.ArgumentParser(description="Central color theming for your WM stack.")
    parser.add_argument("theme", nargs="?", default=None, help="theme preset name in themes/")
    parser.add_argument("--list", action="store_true", help="list available themes")
    parser.add_argument("--restore", action="store_true", help="restore configs from backups")
    parser.add_argument("--dry-run", action="store_true", help="show changes without writing")
    args = parser.parse_args()

    if args.restore:
        restore()
        return
    if args.list:
        list_themes()
        return

    c = load_colors(args.theme)
    print(f"Applying theme: {args.theme or 'colors.toml (default)'}")

    gen_sway(c, args.dry_run, theme_name=args.theme)
    gen_waybar(c, args.dry_run)
    gen_alacritty(c, args.dry_run)
    gen_swaylock(c, args.dry_run)
    gen_dunst(c, args.dry_run)

    if args.dry_run:
        print("(--dry-run: no changes written, skipping reload)")
        return

    reload_all()
    print("Done. Swaylock colors apply on next lock.")


if __name__ == "__main__":
    main()
